# ---------------------------------------------------------------
#  O que NAO vai pro repositorio.
#
#  A regra: assets/ e o que o repositorio carrega e o programa le.
#  Tudo que o programa GERA ou que e seu fica fora, mesmo quando tem
#  uma pasta de mesmo nome dentro de assets/.
#
#  Arte de capa pertence as publicadoras: uso pessoal, nunca commit.
# ---------------------------------------------------------------

# chave da SteamGridDB
sgdb_key.txt

# a lista de tudo que voce possui na Steam
userdata.json
userdata.txt

# seu mapa real: traz o seu steamID3 e os nomes das suas Colecoes.
# o que vai pro repo e config.exemplo.json.
config.json
config.json.bak
config.json.tmp

# arte de jogo (sua biblioteca, nao e nossa pra distribuir)
capas/*
!capas/.gitkeep
originais/
preview/
estado.json

# os seus badges. Os meus sao do Flaticon, cuja licenca gratuita nao
# permite redistribuir; os de assets/badges/ sao Bootstrap Icons (MIT)
# e esses sim vao pro repo.
badges/*
!badges/.gitkeep

# molduras e adesivos que a etapa Aparencia desenha na sua maquina,
# junto com a logo da Steam (marca da Valve, so local). O conjunto que
# acompanha o projeto e assets/molduras/ e assets/adesivos/.
molduras/
adesivos/

# build
build_tmp/
dist/
*.exe
*.spec
*.rar
*.zip
__pycache__/
*.py[cod]

# editores e SO
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
